{
  "env": {
    "SHELL": "/bin/bash"
  },
  "permissions": {
    "allow": [
      "WebFetch(*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "set -a && . ~/dotsecrets/env/klaude && exec ~/bin/klaude"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "theme": "dark",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Agy as a sub-agent: Running the Antigravity CLI (/usr/bin/agy) with --dangerously-skip-permissions is allowed for spawning sub-agents inside any project tree."
    ]
  }
}
